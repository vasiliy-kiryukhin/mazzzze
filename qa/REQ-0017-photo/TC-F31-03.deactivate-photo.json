    {
      "type": "wait_frames",
      "frames": 10
    },
    {
      "type": "action",
      "name": "inventory_toggle",
      "mode": "tap"
    },
    {
      "type": "wait_frames",
      "frames": 10
    },
    {
      "type": "mouse_button",
      "button": "left",
      "mode": "tap",
      "reason": "ЛКМ — видоискатель + отсчёт"
    },
    {
      "type": "wait_frames",
      "frames": 150,
      "reason": "отсчёт ~2.0с, фото создано в слоте 0"
    }
  ],
  "steps": [
    {
      "type": "action",
      "name": "inventory_toggle",
      "mode": "tap",
      "reason": "открыть инвентарь"
    },
    {
      "type": "wait_frames",
      "frames": 5
    },
    {
      "type": "key",
      "physical_keycode": "Key1",
      "mode": "tap"
    },
    {
      "type": "wait_frames",
      "frames": 5
    },
    {
      "type": "key",
      "physical_keycode": "Key1",
      "mode": "tap",
      "reason": "активировать фотографию (слот 0)"
    },
    {
      "type": "wait_frames",
      "frames": 10
    },
    {
      "type": "action",
      "name": "inventory_toggle",
      "mode": "tap",
      "reason": "закрыть инвентарь, фото в руке"
    },
    {
      "type": "wait_frames",
      "frames": 10
    },
    {
      "type": "action",
      "name": "inventory_toggle",
      "mode": "tap",
      "reason": "открыть инвентарь для деактивации"
    },
    {
      "type": "wait_frames",
      "frames": 5
    },
    {
      "type": "key",
      "physical_keycode": "Key1",
      "mode": "tap"
    },
    {
      "type": "wait_frames",
      "frames": 5
    },
    {
      "type": "key",
      "physical_keycode": "Key1",
      "mode": "tap",
      "reason": "повторный выбор слота 0 → toggle деактивации"
    },
    {
      "type": "wait_frames",
      "frames": 10
    },
    {
      "type": "action",
      "name": "inventory_toggle",
      "mode": "tap",
      "reason": "закрыть инвентарь"
    },
    {
      "type": "wait_frames",
      "frames": 10
    }
  ],
  "assertions": [
    {
      "kind": "log_contains",
      "pattern": "\\[Inventory\\] Activate 'photo' → hand \\(slot 0 reserved\\)",
      "reason": "фото активировано",
      "after_step": 4
    },
    {
      "kind": "log_contains",
      "pattern": "\\[Inventory\\] Deactivate 'photo' → slot 0",
      "reason": "фото деактивировано, вернулось в слот",
      "after_step": 9
    },
    {
      "kind": "log_not_contains",
      "pattern": "\\[Photo\\] Entered → teleported",
      "reason": "при деактивации без входа телепорта нет"
    },
    {
      "kind": "log_not_contains",
      "pattern": "\\[Player\\] Teleport →",
      "reason": "телепорта не было"
    }
  ],
  "manual_verification_ref": "10-lifecycle.md → TC-F31-03, «Верификация»",
  "expected_result_summary": "Лог Activate → Deactivate цепочка; телепорта нет; фото не уничтожено."
