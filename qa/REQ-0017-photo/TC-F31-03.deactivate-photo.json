      "dx": 0,
      "dy": -20,
      "reason": "слегка опустить камеру — смотреть вдоль пола"
    },
    {
      "type": "wait_frames",
      "frames": 5
    },
    {
      "type": "action",
      "name": "move_forward",
      "mode": "hold",
      "frames": 6,
      "reason": "короткий шаг вперёд — сместить игрока ~1u для гарантии FocusMinDistance > 1.8u"
    },
    {
      "type": "wait_frames",
      "frames": 10
    },
    {
      "type": "action",
      "name": "inventory_toggle",
      "mode": "tap"
    },
    {
      "type": "wait_frames",
      "frames": 5
    },
    {
      "type": "key",
      "physical_keycode": "Key1",
      "mode": "tap",
      "reason": "ряд 1"
    },
    {
      "type": "wait_frames",
      "frames": 5
    },
    {
      "type": "key",
      "physical_keycode": "Key1",
      "mode": "tap",
      "reason": "колонка 1 → фотоаппарат (слот 0)"
