{
  "$schema": "_scenario-schema.json",
  "format_version": "1.0",
  "_comment": "Прогресс входа сбрасывается при отпускании «вперёд» — телепорт происходит только после второго непрерывного удержания.",
  "id": "TC-F33-03",
  "title": "Прогресс сбрасывается при отпускании «вперёд»",
  "requirement": {
    "feature": "REQ-0017-photo",
    "functional": [
      "F-33"
    ],
    "acceptance": "Отпускание «вперёд» до EnterDuration сбрасывает прогресс в 0 — телепорт требует полного непрерывного удержания",
    "markdown": "30-teleport-entry.md",
    "markdown_anchor": "tc-f33-03"
  },
  "categories": [
    "logic"
  ],
  "scene": "res://test_scene.tscn",
  "run": {
    "headless": true,
    "display": ":0"
  },
  "random_seed_note": "Требует открытого коридора для второго (успешного) удержания.",
  "max_duration_frames": 676,
  "harness_requirements": [
    "capture_gd_print",
    "input_simulation",
    "frame_advance"
  ],
  "preconditions": [
    "Фотография создана в слоте 0 (setup). Игрок смотрит в открытый коридор."
  ],
  "setup": [
    {
      "type": "wait_frames",
      "frames": 90,
      "reason": "инициализация мира"
    },
    {
      "type": "mouse_motion",
      "dx": 0,
      "dy": -20,
      "reason": "слегка опустить камеру — смотреть вдоль пола"
    },
    {
      "type": "wait_frames",
      "frames": 5
    },
    {
      "type": "action",
      "name": "move_forward",
      "mode": "hold",
      "frames": 6,
      "reason": "короткий шаг вперёд — сместить игрока ~1u для гарантии FocusMinDistance > 1.8u"
    },
    {
      "type": "wait_frames",
      "frames": 10
    },
    {
      "type": "action",
      "name": "inventory_toggle",
      "mode": "tap"
    },
    {
      "type": "wait_frames",
      "frames": 5
    },
    {
      "type": "key",
      "physical_keycode": "Key1",
      "mode": "tap"
    },
    {
      "type": "wait_frames",
      "frames": 5
    },
    {
      "type": "key",
      "physical_keycode": "Key1",
      "mode": "tap",
      "reason": "фотоаппарат (слот 0)"
    },
    {
      "type": "wait_frames",
      "frames": 10
    },
    {
      "type": "action",
      "name": "inventory_toggle",
      "mode": "tap"
    },
    {
      "type": "wait_frames",
      "frames": 10
    },
    {
      "type": "mouse_button",
      "button": "left",
      "mode": "tap"
    },
    {
      "type": "wait_frames",
      "frames": 150,
      "reason": "отсчёт, фото создано"
    }
  ],
  "steps": [
    {
      "type": "action",
      "name": "inventory_toggle",
      "mode": "tap"
    },
    {
      "type": "wait_frames",
      "frames": 5
    },
    {
      "type": "key",
      "physical_keycode": "Key1",
      "mode": "tap"
    },
    {
      "type": "wait_frames",
      "frames": 5
    },
    {
      "type": "key",
      "physical_keycode": "Key1",
      "mode": "tap",
      "reason": "активировать фото"
    },
    {
      "type": "wait_frames",
      "frames": 10
    },
    {
      "type": "action",
      "name": "inventory_toggle",
      "mode": "tap"
    },
    {
      "type": "wait_frames",
      "frames": 10
    },
    {
      "type": "action",
      "name": "move_forward",
      "mode": "hold",
      "frames": 48,
      "reason": "первое удержание: 0.8с < EnterDuration — прогресс НЕ должен завершиться"
    },
    {
      "type": "wait_frames",
      "frames": 30,
      "reason": "пауза — «вперёд» отпущен, прогресс сброшен в 0"
    },
    {
      "type": "action",
      "name": "move_forward",
      "mode": "hold",
      "frames": 120,
      "reason": "второе удержание: 2.0с > EnterDuration — прогресс с нуля, должен дойти до телепорта"
    },
    {
      "type": "wait_frames",
      "frames": 20,
      "reason": "пост-телепорт"
    }
  ],
  "assertions": [
    {
      "kind": "log_contains",
      "pattern": "\\[Inventory\\] Activate 'photo' → hand \\(slot 0 reserved\\)",
      "reason": "фото активировано",
      "after_step": 4
    },
    {
      "kind": "log_contains",
      "pattern": "\\[Photo\\] Entered → teleported",
      "reason": "телепорт после второго (полного) удержания",
      "after_step": 10
    },
    {
      "kind": "log_contains",
      "pattern": "\\[Player\\] Teleport → world=",
      "reason": "игрок телепортирован",
      "after_step": 10
    }
  ],
  "manual_verification_ref": "30-teleport-entry.md → TC-F33-03, «Верификация»",
  "expected_result_summary": "После первого короткого удержания телепорта нет; после второго полного — телепорт. Ровно один маркер Entered → teleported."
}