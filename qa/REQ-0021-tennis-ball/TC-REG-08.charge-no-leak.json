{
  "$schema": "_scenario-schema.json",
  "format_version": "1.0",
  "_comment": "Заряд не «протекает» через деактивацию (A) и drop-activated (B): отпускание ЛКМ после этих действий не вызывает случайного броска (нет [Throw] launch).",
  "id": "TC-REG-08",
  "title": "Заряд не «протекает» через деактивацию/выброс активированного",
  "requirement": { "feature": "REQ-0021-tennis-ball", "functional": ["F-50", "F-47"], "acceptance": "Деактивация/drop-activated сбрасывают заряд без броска", "markdown": "60-edge-regression.md", "markdown_anchor": "tc-reg-08" },
  "categories": ["logic"],
  "scene": "res://main.tscn",
  "run": { "headless": true, "display": ":0" },
  "max_duration_frames": 720,
  "harness_requirements": ["capture_gd_print", "input_simulation", "frame_advance", "node_property_read"],
  "preconditions": ["Мяч активирован в руку"],
  "setup": [
    { "type": "wait_frames", "frames": 90, "reason": "инициализация мира" },
    { "type": "action", "name": "inventory_toggle", "mode": "tap" },
    { "type": "wait_frames", "frames": 5 },
    { "type": "key", "physical_keycode": "Key1", "mode": "tap" },
    { "type": "wait_frames", "frames": 5 },
    { "type": "key", "physical_keycode": "Key2", "mode": "tap", "reason": "активировать мяч (фаза A)" },
    { "type": "wait_frames", "frames": 10 },
    { "type": "action", "name": "inventory_toggle", "mode": "tap" },
    { "type": "wait_frames", "frames": 10 }
  ],
  "steps": [
    { "type": "action", "name": "use_activated", "mode": "press", "reason": "ФАЗА A: зажать ЛКМ (заряд идёт)" },
    { "type": "wait_frames", "frames": 40 },
    { "type": "action", "name": "inventory_toggle", "mode": "tap", "reason": "открыть инвентарь для деактивации" },
    { "type": "wait_frames", "frames": 5 },
    { "type": "key", "physical_keycode": "Key1", "mode": "tap" },
    { "type": "wait_frames", "frames": 5 },
    { "type": "key", "physical_keycode": "Key2", "mode": "tap", "reason": "toggle забронированной ячейки → деактивация" },
    { "type": "wait_frames", "frames": 5 },
    { "type": "action", "name": "use_activated", "mode": "release", "reason": "отпустить ЛКМ после деактивации — броска быть не должно" },
    { "type": "wait_frames", "frames": 10 },
    { "type": "action", "name": "inventory_toggle", "mode": "tap", "reason": "подготовить повторную активацию (фаза B)" },
    { "type": "wait_frames", "frames": 5 },
    { "type": "key", "physical_keycode": "Key1", "mode": "tap" },
    { "type": "wait_frames", "frames": 5 },
    { "type": "key", "physical_keycode": "Key2", "mode": "tap", "reason": "повторно активировать мяч" },
    { "type": "wait_frames", "frames": 5 },
    { "type": "action", "name": "use_activated", "mode": "press", "reason": "ФАЗА B: зажать ЛКМ (заряд идёт)" },
    { "type": "wait_frames", "frames": 40 },
    { "type": "key", "physical_keycode": "Key1", "mode": "tap", "reason": "выбрать ряд 1 (ряд уже выбран — выбор колонки)" },
    { "type": "wait_frames", "frames": 5 },
    { "type": "key", "physical_keycode": "Key2", "mode": "tap", "modifiers": ["shift"], "reason": "Shift+колонка 2 на забронированном слоте → DropActivated" },
    { "type": "wait_frames", "frames": 5 },
    { "type": "action", "name": "use_activated", "mode": "release", "reason": "отпустить ЛКМ после drop — броска быть не должно" },
    { "type": "wait_frames", "frames": 120, "reason": "дождаться посадки DropProjectile" },
    { "type": "action", "name": "inventory_toggle", "mode": "tap" },
    { "type": "wait_frames", "frames": 10 }
  ],
  "assertions": [
    { "kind": "log_contains", "pattern": "\\[Inventory\\] Deactivate 'tennis_ball' → slot 1", "reason": "фаза A: деактивация выполнена" },
    { "kind": "log_contains", "pattern": "\\[Inventory\\] Drop 'tennis_ball' → world at", "reason": "фаза B: выброс активированного (DropProjectile)" },
    { "kind": "log_not_contains", "pattern": "\\[Throw\\] launch", "reason": "ни в одной фазе заряд не «протёк» в бросок" },
    { "kind": "log_not_contains", "pattern": "\\[Inventory\\] Throw 'tennis_ball'", "reason": "броска не было" },
    {
      "kind": "node_property",
      "path": "/root/Main/Player",
      "property": "ExternalSpeedFactor",
      "equals": 1.0,
      "at": "end",
      "reason": "заряд сброшен, скорость восстановлена"
    }
  ],
  "manual_verification_ref": "60-edge-regression.md → TC-REG-08, «Верификация»",
  "expected_result_summary": "Deactivate (A) и Drop (B) без Throw/launch; ExternalSpeedFactor=1.0."
}
