{
  "$schema": "_scenario-schema.json",
  "format_version": "1.0",
  "_comment": "Бесшовная посадка: при переходе снаряд → WorldItem размер (BallSize=0.2) и позиция мяча не меняются (регрессия ×2.5 размера рука/снаряд).",
  "id": "TC-F48-05",
  "title": "Бесшовная посадка — мяч не проваливается и не дёргается",
  "requirement": { "feature": "REQ-0021-tennis-ball", "functional": ["F-48"], "acceptance": "Переход снаряд→предмет бесшовнов; размер един (BallSize)", "markdown": "30-throw-physics.md", "markdown_anchor": "tc-f48-05" },
  "categories": ["visual"],
  "scene": "res://main.tscn",
  "run": { "headless": false, "display": ":0" },
  "max_duration_frames": 420,
  "harness_requirements": ["capture_gd_print", "input_simulation", "frame_advance", "screenshot"],
  "preconditions": ["Мяч активирован в руку"],
  "setup": [
    { "type": "wait_frames", "frames": 90, "reason": "инициализация мира" },
    { "type": "action", "name": "inventory_toggle", "mode": "tap" },
    { "type": "wait_frames", "frames": 5 },
    { "type": "key", "physical_keycode": "Key1", "mode": "tap" },
    { "type": "wait_frames", "frames": 5 },
    { "type": "key", "physical_keycode": "Key2", "mode": "tap", "reason": "активировать мяч" },
    { "type": "wait_frames", "frames": 10 },
    { "type": "action", "name": "inventory_toggle", "mode": "tap" },
    { "type": "wait_frames", "frames": 10 }
  ],
  "steps": [
    { "type": "action", "name": "use_activated", "mode": "hold", "frames": 40, "reason": "бросок" },
    { "type": "wait_frames", "frames": 90, "reason": "подойти к концу полёта (мяч у пола)" },
    { "type": "screenshot", "path": "/tmp/tc-f48-05-pre-land.png", "reason": "последний кадр снаряда" },
    { "type": "wait_frames", "frames": 30, "reason": "переход в WorldItem" },
    { "type": "screenshot", "path": "/tmp/tc-f48-05-post-land.png", "reason": "лежащий WorldItem" }
  ],
  "assertions": [
    { "kind": "log_contains", "pattern": "\\[Throw\\] land → WorldItem at", "reason": "переход состоялся" },
    {
      "kind": "manual_visual_check",
      "description": "На двух соседних скриншотах (снаряд у пола → лежащий WorldItem) размер мяча одинаков (BallSize=0.2), нет проседания в пол и рывка по X/Z.",
      "md_ref": "30-throw-physics.md → TC-F48-05",
      "screenshots": ["/tmp/tc-f48-05-pre-land.png", "/tmp/tc-f48-05-post-land.png"]
    }
  ],
  "manual_verification_ref": "30-throw-physics.md → TC-F48-05, «Верификация»",
  "expected_result_summary": "Размер/позиция мяча не меняются при переходе снаряд → WorldItem."
}
