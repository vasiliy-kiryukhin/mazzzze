{
  "$schema": "_scenario-schema.json",
  "format_version": "1.0",
  "_comment": "Движение во время зарядки разрешено, но скорость = 45% от обычной. Проверяем напрямую через ExternalSpeedFactor: до заряда = 1.0, во время заряда = 0.45 (не 0, не 1.0).",
  "id": "TC-F50-06",
  "title": "Движение во время зарядки разрешено, но медленнее",
  "requirement": { "feature": "REQ-0021-tennis-ball", "functional": ["F-50"], "acceptance": "Движение разрешено; скорость = MoveSpeedFactorWhileCharging (0.45)", "markdown": "20-input-charge-cancel.md", "markdown_anchor": "tc-f50-06" },
  "categories": ["input", "model"],
  "scene": "res://main.tscn",
  "run": { "headless": true, "display": ":0" },
  "max_duration_frames": 360,
  "harness_requirements": ["capture_gd_print", "input_simulation", "frame_advance", "node_property_read"],
  "preconditions": ["Мяч активирован в руку"],
  "setup": [
    { "type": "wait_frames", "frames": 90, "reason": "инициализация мира" },
    { "type": "action", "name": "inventory_toggle", "mode": "tap" },
    { "type": "wait_frames", "frames": 5 },
    { "type": "key", "physical_keycode": "Key1", "mode": "tap" },
    { "type": "wait_frames", "frames": 5 },
    { "type": "key", "physical_keycode": "Key2", "mode": "tap", "reason": "активировать мяч" },
    { "type": "wait_frames", "frames": 10 },
    { "type": "action", "name": "inventory_toggle", "mode": "tap" },
    { "type": "wait_frames", "frames": 10 }
  ],
  "steps": [
    { "type": "node_property", "path": "/root/Main/Player", "property": "ExternalSpeedFactor", "capture_as": "speed_before", "reason": "до заряда" },
    { "type": "action", "name": "use_activated", "mode": "press", "reason": "зажать ЛКМ" },
    { "type": "action", "name": "move_forward", "mode": "press", "reason": "двигаться вперёд во время заряда" },
    { "type": "wait_frames", "frames": 30, "reason": "набрать заряд и движение" },
    { "type": "node_property", "path": "/root/Main/Player", "property": "ExternalSpeedFactor", "capture_as": "speed_during", "reason": "во время заряда + движения" },
    { "type": "action", "name": "move_forward", "mode": "release" },
    { "type": "action", "name": "use_activated", "mode": "release", "reason": "отпустить — бросок/восстановление скорости" },
    { "type": "wait_frames", "frames": 30 }
  ],
  "assertions": [
    { "kind": "compare", "a": "speed_before", "op": "eq", "b": 1.0, "tolerance": 0.001, "reason": "до заряда скорость штатная" },
    { "kind": "compare", "a": "speed_during", "op": "eq", "b": 0.45, "tolerance": 0.001, "reason": "во время заряда множитель = 0.45 (движение разрешено, но медленнее)" }
  ],
  "manual_verification_ref": "20-input-charge-cancel.md → TC-F50-06, «Верификация»",
  "expected_result_summary": "ExternalSpeedFactor: 1.0 до заряда → 0.45 во время заряда (движение не блокируется)."
}
