{
  "$schema": "_scenario-schema.json",
  "format_version": "1.0",
  "_comment": "Точка выпуска = кисть (HandThrowOrigin + dir*0.35), а не камера/спина. Скриншот первого кадра полёта.",
  "id": "TC-F48-09",
  "title": "Выпуск из руки, а не из спины/камеры",
  "requirement": { "feature": "REQ-0021-tennis-ball", "functional": ["F-48"], "acceptance": "Выпуск из кисти (HandThrowOrigin)", "markdown": "30-throw-physics.md", "markdown_anchor": "tc-f48-09" },
  "categories": ["visual"],
  "scene": "res://main.tscn",
  "run": { "headless": false, "display": ":0" },
  "max_duration_frames": 360,
  "harness_requirements": ["capture_gd_print", "input_simulation", "frame_advance", "screenshot"],
  "preconditions": ["Мяч активирован в руку"],
  "setup": [
    { "type": "wait_frames", "frames": 90, "reason": "инициализация мира" },
    { "type": "action", "name": "inventory_toggle", "mode": "tap" },
    { "type": "wait_frames", "frames": 5 },
    { "type": "key", "physical_keycode": "Key1", "mode": "tap" },
    { "type": "wait_frames", "frames": 5 },
    { "type": "key", "physical_keycode": "Key2", "mode": "tap", "reason": "активировать мяч" },
    { "type": "wait_frames", "frames": 10 },
    { "type": "action", "name": "inventory_toggle", "mode": "tap" },
    { "type": "wait_frames", "frames": 10 }
  ],
  "steps": [
    { "type": "action", "name": "use_activated", "mode": "hold", "frames": 50, "reason": "бросок" },
    { "type": "screenshot", "path": "/tmp/tc-f48-09-spawn.png", "reason": "первый кадр: мяч отделяется от кисти" },
    { "type": "wait_frames", "frames": 150, "reason": "дождаться land" }
  ],
  "assertions": [
    { "kind": "log_contains", "pattern": "\\[Throw\\] launch force=", "reason": "бросок выполнен" },
    {
      "kind": "manual_visual_check",
      "description": "На первом кадре полёта мяч отделяется от правой кисти игрока (область руки), а не вылетает из камеры/из-за спины/из центра тела.",
      "md_ref": "30-throw-physics.md → TC-F48-09",
      "screenshot": "/tmp/tc-f48-09-spawn.png"
    }
  ],
  "manual_verification_ref": "30-throw-physics.md → TC-F48-09, «Верификация»",
  "expected_result_summary": "Мяч вылетает из кисти игрока."
}
